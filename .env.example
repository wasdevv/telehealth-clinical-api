# Copy to .env and fill in. Never commit the filled file.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/telehealth_clinical_api_development
REDIS_URL=redis://localhost:6379/0
SECRET_KEY_BASE=generate_with__bin_rails_secret

# Devise JWT signing key. `bin/rails secret` produces a suitable value.
DEVISE_JWT_SECRET_KEY=generate_with__bin_rails_secret

# Active Record Encryption for PHI (medical record notes/diagnosis) and the TOTP secret.
# `bin/rails db:encryption:init` prints a fresh set of all three.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Google OAuth (omniauth-google-oauth2).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# telehealth-billing-service (Django). `billing` is the Compose service name.
DJANGO_BILLING_URL=http://billing:8000
INTERNAL_SERVICE_TOKEN=shared_with_the_billing_service

# Optional
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=info
