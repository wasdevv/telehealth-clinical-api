# Copy to .env and adjust. dotenv-rails loads this in development and test only;
# production and Docker Compose pass the same names in as real environment variables.
# Never commit the filled file.

# --- datastores -----------------------------------------------------------------------
# These match docker-compose.dev.yml's default host ports. They are deliberately not
# 5432/6379: those are usually already taken, and connecting to the wrong Redis by
# accident is worse than a connection error.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_URL=redis://127.0.0.1:56379/0

# DATABASE_URL overrides POSTGRES_* entirely. Production and Compose use it; leave it
# unset locally so `RAILS_ENV=test` cannot end up pointed at the development database.
# DATABASE_URL=

# --- secrets --------------------------------------------------------------------------
# Development and test fall back to fixed worthless values, so the app boots without
# these. Every other environment refuses to start without them.

# Left commented rather than blank. dotenv *defines* a key written as `FOO=`, and Rails
# reads SECRET_KEY_BASE straight out of the environment — an empty one is a boot failure
# no application code can rescue. Uncomment and fill, or leave them alone in development.

# `bin/rails secret` prints a suitable value for each of these two.
# SECRET_KEY_BASE=
# DEVISE_JWT_SECRET_KEY=

# `bin/rails db:encryption:init` prints all three at once.
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Google OAuth ---------------------------------------------------------------------
# Optional locally: password login works without them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- telehealth-billing-service (Django) ----------------------------------------------
# `billing` is the Compose service name. Locally, point this anywhere unreachable to
# watch the timeout path: the booking survives and the invoice is retried in background.
DJANGO_BILLING_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=shared-with-the-billing-service

# --- optional -------------------------------------------------------------------------
RAILS_MAX_THREADS=5
SIDEKIQ_CONCURRENCY=5
