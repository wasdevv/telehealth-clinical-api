#!/usr/bin/env bash
# Walks the whole golden path against a running server and fails loudly if any step
# misbehaves. This is the manual counterpart to `bundle exec rspec`: the suite proves the
# code, this proves the deployment — real HTTP, real PostgreSQL, real Redis.
#
#   bin/rails server                  # terminal 1
#   bin/rails db:seed                 # once
#   bin/smoke                         # terminal 2
#
# Override the target with: API=http://localhost:3999 bin/smoke
set -uo pipefail

API="${API:-http://localhost:3000}"
PASSWORD="telehealth-demo-2026"
failures=0

pass() { printf '  \033[32mok\033[0m   %s\n' "$1"; }
fail() { printf '  \033[31mFAIL\033[0m %s\n' "$1"; failures=$((failures + 1)); }
step() { printf '\n\033[1m%s\033[0m\n' "$1"; }

# jq is not assumed; python3 ships with every machine that can run this project.
json() { python3 -c "import json,sys;d=json.load(sys.stdin);print(eval('d'+sys.argv[1]) if True else '')" "$1" 2>/dev/null; }

gql() { # gql <token> <query-json-escaped>
  curl -s -X POST "$API/graphql" \
    -H 'Content-Type: application/json' \
    -H "Authorization: Bearer $1" \
    -d "{\"query\":\"$2\"}"
}

login() { # login <email> -> token on stdout
  curl -s -X POST "$API/auth/login" -H 'Content-Type: application/json' \
    -d "{\"user\":{\"email\":\"$1\",\"password\":\"$PASSWORD\"}}" | json "['token']"
}

step "1. The service is up"
code=$(curl -s -o /dev/null -w '%{http_code}' "$API/up")
[ "$code" = "200" ] && pass "GET /up -> 200" || { fail "GET /up -> $code (is the server running?)"; exit 1; }

step "2. The domain is closed without a token"
code=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$API/graphql" -H 'Content-Type: application/json' -d '{"query":"{ me { id } }"}')
[ "$code" = "401" ] && pass "POST /graphql with no token -> 401" || fail "POST /graphql with no token -> $code, expected 401"

step "3. Password login issues a JWT"
TOKEN=$(login "sam.patient@example.com")
[ -n "$TOKEN" ] && pass "logged in as sam.patient@example.com" || { fail "no token returned (did you run bin/rails db:seed?)"; exit 1; }

role=$(gql "$TOKEN" '{ me { role patient { fullName } } }' | json "['data']['me']['role']")
[ "$role" = "PATIENT" ] && pass "me.role = PATIENT" || fail "me.role = $role, expected PATIENT"

step "4. The directory lists free slots"
# The furthest slot, not the nearest: it is more than 24 hours out, so booking it takes
# the representative reminder path (perform_at) rather than the inside-the-window one.
SLOT=$(gql "$TOKEN" '{ doctors(specialty: \"cardiology\") { edges { node { fullName availabilities { id } } } } }' \
  | json "['data']['doctors']['edges'][0]['node']['availabilities'][-1]['id']")
[ -n "$SLOT" ] && pass "found a free cardiology slot (availability #$SLOT)" || { fail "no free slot; re-run bin/rails db:seed"; exit 1; }

step "5. Booking that slot works"
booked=$(gql "$TOKEN" "mutation { bookAppointment(availabilityId: \\\"$SLOT\\\") { resource { id status externalRef } errors { code message } } }")
APPT=$(echo "$booked" | json "['data']['bookAppointment']['resource']['id']")
status=$(echo "$booked" | json "['data']['bookAppointment']['resource']['status']")
ref=$(echo "$booked" | json "['data']['bookAppointment']['resource']['externalRef']")
[ "$status" = "SCHEDULED" ] && pass "appointment #$APPT is SCHEDULED" || fail "status = $status; payload: $booked"
[ "$ref" = "appointment:$APPT" ] && pass "externalRef = $ref (generated by PostgreSQL)" || fail "externalRef = $ref"

step "6. The same slot cannot be booked twice"
OTHER=$(login "kai.patient@example.com")
code=$(gql "$OTHER" "mutation { bookAppointment(availabilityId: \\\"$SLOT\\\") { resource { id } errors { code } } }" \
  | json "['data']['bookAppointment']['errors'][0]['code']")
[ "$code" = "slot_taken" ] && pass "second booking rejected with slot_taken" || fail "expected slot_taken, got $code"

step "7. The doctor files a clinical record"
DOCTOR=$(login "dr.reyes@example.com")
diag=$(gql "$DOCTOR" "mutation { addMedicalRecord(appointmentId: \\\"$APPT\\\", diagnosis: \\\"Essential hypertension\\\", notes: \\\"BP 150/95, start amlodipine 5mg\\\") { resource { diagnosis } errors { code message } } }" \
  | json "['data']['addMedicalRecord']['resource']['diagnosis']")
[ "$diag" = "Essential hypertension" ] && pass "record filed by the responsible doctor" || fail "record not filed: $diag"

step "8. Only the participants can read it"
own=$(gql "$TOKEN" "query { appointment(id: \\\"$APPT\\\") { medicalRecord { notes } } }" \
  | json "['data']['appointment']['medicalRecord']['notes']")
[ -n "$own" ] && pass "the patient reads their own notes" || fail "the patient could not read their own record"

stranger=$(gql "$OTHER" "query { appointment(id: \\\"$APPT\\\") { id medicalRecord { diagnosis notes } } }")
echo "$stranger" | grep -q 'hypertension' && fail "PHI LEAKED to a third party: $stranger" || pass "a third party sees null, and no PHI in the body"

step "9. A patient cannot author a chart"
code=$(gql "$TOKEN" "mutation { addMedicalRecord(appointmentId: \\\"$APPT\\\", diagnosis: \\\"Self diagnosis\\\") { errors { code } } }" \
  | json "['data']['addMedicalRecord']['errors'][0]['code']")
[ "$code" = "record_exists" ] || [ "$code" = "not_responsible_doctor" ] && pass "refused with $code" || fail "expected a refusal, got $code"

step "10. Cancelling frees the slot"
status=$(gql "$TOKEN" "mutation { cancelAppointment(id: \\\"$APPT\\\", reason: \\\"Feeling better\\\") { resource { status } errors { code } } }" \
  | json "['data']['cancelAppointment']['resource']['status']")
[ "$status" = "CANCELLED" ] && pass "appointment #$APPT is CANCELLED" || fail "status = $status"

rebooked=$(gql "$OTHER" "mutation { bookAppointment(availabilityId: \\\"$SLOT\\\") { resource { id status } errors { code } } }" \
  | json "['data']['bookAppointment']['resource']['status']")
[ "$rebooked" = "SCHEDULED" ] && pass "the freed slot is bookable again" || fail "rebooking gave $rebooked"

step "11. Logout really revokes the token"
curl -s -o /dev/null -X DELETE "$API/auth/logout" -H "Authorization: Bearer $TOKEN"
code=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$API/graphql" \
  -H 'Content-Type: application/json' -H "Authorization: Bearer $TOKEN" -d '{"query":"{ me { id } }"}')
[ "$code" = "401" ] && pass "the revoked token is refused with 401" || fail "revoked token still works ($code)"

step "12. Schema limits hold"
msg=$(gql "$OTHER" '{ myAppointments(first: 500) { edges { node { id } } } }' | json "['errors'][0]['message']")
echo "$msg" | grep -qi complexity && pass "an oversized query is refused: $msg" || fail "no complexity limit fired"

printf '\n'
if [ "$failures" -eq 0 ]; then
  printf '\033[32mall checks passed\033[0m\n'
else
  printf '\033[31m%d check(s) failed\033[0m\n' "$failures"
fi
exit "$failures"
